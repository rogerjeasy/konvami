# Konvami app settings. Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app,
# so they must never be secrets: API keys stay server-side in AWS Secrets Manager.
# Terraform will print these (cd infra/envs/dev && terraform output -raw mobile_env) once the
# backend exists. The first-launch screens need none of them.
EXPO_PUBLIC_API_URL=

# Accounts (Amazon Cognito user pool, infra/modules/auth). Public identifiers, not secrets.
EXPO_PUBLIC_AUTH_REGION=
EXPO_PUBLIC_AUTH_CLIENT_ID=

# Legal pages on the website (apps/site). Empty until they exist: the links then open an in-app
# placeholder. {lang} is replaced by the app's language (en, de, fr, it).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Only for building the app onto your own iPhone (pnpm device:ios): your Apple team id, 10
# characters. Xcode shows it once a team is chosen (Signing & Capabilities), and it is the
# DEVELOPMENT_TEAM in ios/*.xcodeproj/project.pbxproj. Not a secret, but yours: keep it in .env.
APPLE_TEAM_ID=
