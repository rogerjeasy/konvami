# Dependencies and build output
node_modules/
dist/
.turbo/
*.tsbuildinfo
coverage/

# Expo / React Native
.expo/
apps/mobile/ios/
apps/mobile/android/
web-build/
.metro-health-check*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# Environment and secrets: only *.example files are ever committed
.env
.env.*
!.env.example
*.secret
*.secrets

# Python (backend)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/.build/
**/tfplan

# OS / editors / local tooling
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.playwright-mcp/
.superpowers/

# The speech of the accuracy test (services/api/evals/verbatim): made again on demand.
services/api/evals/verbatim/.audio/

# Firebase (push on Android): the service-account key is a secret, and the app's Firebase
# config is given to EAS builds as a file variable. Neither is ever committed.
all-things-agentics-firebase-adminsdk-fbsvc-0a3de0efed.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
