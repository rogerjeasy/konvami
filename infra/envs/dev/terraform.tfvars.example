# Copy to terraform.tfvars (gitignored). Never commit real values.

budget_alert_emails = ["you@example.com"]

# budget = { target_usd = 150, ceiling_usd = 250 }

# Who may open the costs page in the app: the account's user pool subject (sub).
# cost_owners = ["00000000-0000-4000-8000-000000000000"]

# github_deploy = {
#   repository     = "<owner>/konvami"
#   subject_prefix = "repo:<owner>@<owner-id>/konvami@<repo-id>"
#   environment    = "dev"
# }

# The OpenAI API key (voice calls, text models). Stored in AWS Secrets Manager by Terraform and
# never written to state. After changing it, also raise openai_api_key_version by one.
openai_api_key = "sk-..."
# openai_api_key_version = 1

# Crash reports from the API and the call worker go to this Sentry project (spec §6.21.4). Leave it
# out to turn them off. The app has its own DSN, EXPO_PUBLIC_SENTRY_DSN in apps/mobile/.env.
# sentry_dsn = "https://<key>@<org>.ingest.de.sentry.io/<project>"

# Publish the website with the privacy policy, once apps/site/site.config.ts is filled in and the
# site is built (pnpm --filter @konvami/site build).
# publish_site = true
