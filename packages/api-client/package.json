{
  "name": "@konvami/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Konvami API. Types are generated from the backend's OpenAPI schema.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
